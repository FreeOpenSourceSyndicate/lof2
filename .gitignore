# Build artifacts
lof-native
cpu_test
*.o
*.a

# Downloaded game archives and extracted game data (proprietary, do not commit)
downloads/
game/
*.zip
# Owner-supplied saves live in saves/ (content-addressed, see saves/README.md)
# and ARE committed: they are the only copy of some fixtures (e.g. the Cyldane
# save used by tests/port_town_test.py).  saves/inbox/ is the transient drop
# zone -- files there are filed into saves/ by tools/ingest-save.sh and the
# originals need not be committed.
/saves/inbox/*
!/saves/inbox/.gitkeep
# A save dropped at the repo root (any GAME<n>, GAME<n>.SAV) is transient: it is
# ingested into saves/ by tools/ingest-save.sh, so never commit it here.
/GAME[0-9]*

# Python cache
__pycache__/
*.pyc

# Scratch
*.tmp

# native drop-in binaries (build with `make port`)
/lof
/vor
font_test
char_test
dungeon_test
